# A language whose comment prefix has no marker in it leaves nothing
# to write a doc comment with, and the driver does not refuse it, it
# dies partway with the file unwritten.
#
# The rest are delimiters quoted inside a body, where org's raw
# searches find an anchor and a tree finds text. None of the searches
# is anchored at a column, so indentation is not an escape and the
# books below carry both spellings. Two of the shapes were measured
# writing different files from the two engines while each run
# succeeded: a closer carrying a trailing word, which no parser ends
# a block on but the search behind a doc comment stops at, and a name
# quoted beside an opener, which org's noweb lookup answers with the
# carrying block.

# oracle: skip blank.org emacs dies partway here rather than
# refusing, so it cannot be compared.

! exec babble tangle blank.org
stderr 'no comment marker'
! exists blank.out

! exec babble tangle quoted.org
stderr 'quoted inside an example block'
! exists quoted.go

! exec babble tangle indented.org
stderr 'quoted inside an example block'
! exists indented.go

! exec babble tangle trailing.org
stderr 'quoted inside a src block'
! exists trailing.go

! exec babble tangle smuggled.org
stderr 'quoted inside a src block'
! exists smuggled.go

# parse judges a book by the same rules tangle does, which is the
# whole reason both go through one reader.
! exec babble parse trailing.org
stderr 'quoted inside a src block'

-- .lit/comments.json --
{"blank": " "}
-- blank.org --
#+title: a language with no marker

* Nothing to write with

The docstring that cannot be wrapped.

#+begin_src blank :tangle blank.out :comments org
whatever
#+end_src
-- quoted.org --
#+title: a delimiter quoted inside an example

* The paragraph org will not see

#+begin_example
#+end_src
#+end_example

#+begin_src go :tangle quoted.go :comments org
package quoted
#+end_src
-- indented.org --
#+title: an indented delimiter in an example body

#+begin_example
  #+begin_src go
  x
#+end_example

#+begin_src go :tangle indented.go :comments org
package a
#+end_src
-- trailing.org --
#+title: a closer carrying a trailing word

#+begin_src go :tangle trailing.go
package a
#+end_src trailing
#+end_src
Prose right after the block, with no blank line above it.

#+begin_src go :tangle trailing.go :comments org
func B() {}
#+end_src
-- smuggled.org --
#+title: a name quoted beside an opener

#+begin_src go :tangle smuggled.go
package a
#+name: inner
#+begin_src go
SMUGGLED
#+end_src

#+name: inner
#+begin_src go :tangle no
REAL
#+end_src

#+begin_src go :tangle smuggled.go :noweb yes
<<inner>>
#+end_src
