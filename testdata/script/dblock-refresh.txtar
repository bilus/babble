	return "hi"
}
#+end_src

#+name: greet--planned
#+begin_src go :tangle no
package greet

func Greet() string {
	return ""
}
#+end_src

#+begin: src-block-diff :old greet :new greet--planned
#+begin_src diff
@@ -1,5 +1,5 @@
 package greet
 
 func Greet() string {
-	return "hi"
+	return ""
 }
#+end_src
#+end:

#+begin: src-block-diff :old greet :new greet
no differences
#+end:

* PLANNED An entry
* live in lowercase

x = hole(9): a lowercase marker.
y = HOLE(9): an uppercase marker.

#+begin: plan-toc
- [[file:refresh.org::15][15]] twin of greet
- [[file:refresh.org::24][24]] generated diff
- [[file:refresh.org::36][36]] generated diff
- [[file:refresh.org::40][40]] entry: PLANNED An entry
- [[file:refresh.org::41][41]] entry: live in lowercase
- [[file:refresh.org::43][43]] hole 9: a lowercase marker.
- [[file:refresh.org::44][44]] hole 9: an uppercase marker.

#+end:

Tail prose.
