# Every block shape in one book: a named src block with a switch
# and a header, a plain one, both dynamic blocks (the generated
# diff holding a real src block), an example whose escaped
# delimiters stay text, a quote with a child, and upper-case
# delimiters.

exec babble parse --dump b.org
cmp stdout want.json

-- b.org --
#+title: blocks

* Blocks

#+name: greet
#+begin_src go -i :tangle greet.go :comments org
package greet
#+end_src

#+begin_src go
plain
#+end_src

#+begin: plan-toc
- [[file:b.org::3][3]] entry: Blocks
#+end:

#+begin: src-block-diff :old greet :new greet
#+begin_src diff
-old
+new
#+end_src
#+end:

#+begin_example
,#+begin_src go
not a block
,#+end_src
#+end_example

#+begin_quote
Quoted prose.
#+end_quote

#+BEGIN_SRC go :tangle up.go
upper case delimiters
#+END_SRC
